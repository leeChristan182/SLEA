#########################################
# SLEA ENVIRONMENT CONFIGURATION (EXAMPLE)
# ---------------------------------------
# Instructions:
# 1. Copy this file and rename it to `.env`
# 2. Fill in the required values below
# 3. Run: php artisan key:generate
#########################################

# ---------------------------------------
# Application Settings
# ---------------------------------------

# Application display name
APP_NAME="SLEA System"

# Environment type: local | staging | production
APP_ENV=production

# Application encryption key (AUTO-GENERATED)
# Generate using: php artisan key:generate
APP_KEY=

# Debug mode (false in production)
APP_DEBUG=false

# Base URL of the deployed system
# Example:
#   https://slea.usep.edu.ph
APP_URL=http://localhost

# ---------------------------------------
# Localization
# ---------------------------------------

# Default language
APP_LOCALE=en

# Fallback language if translation is missing
APP_FALLBACK_LOCALE=en

# Faker locale (for test data, optional)
APP_FAKER_LOCALE=en_US

# ---------------------------------------
# Maintenance Mode
# ---------------------------------------

# Maintenance driver (file recommended)
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ---------------------------------------
# Security & Hashing
# ---------------------------------------

# Password hashing strength (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ---------------------------------------
# Logging
# ---------------------------------------

# Logging configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------
# Database Configuration
# ---------------------------------------

# Database driver (MySQL recommended)
DB_CONNECTION=mysql

# Database host (usually localhost or 127.0.0.1)
DB_HOST=127.0.0.1

# Database port (default MySQL: 3306)
DB_PORT=3306

# Database name (must already exist)
# Example: slea_system
DB_DATABASE=

# Database username
# Example: slea_user
DB_USERNAME=

# Database password
DB_PASSWORD=

# ---------------------------------------
# Session Management
# ---------------------------------------

# Session storage method
SESSION_DRIVER=file

# Session lifetime in minutes (e.g., 10 = auto logout after 10 min idle)
SESSION_LIFETIME=10

# Encrypt session data (recommended false for file driver)
SESSION_ENCRYPT=false

SESSION_PATH=/
SESSION_DOMAIN=null

# ---------------------------------------
# SLEA-Specific Settings
# ---------------------------------------

# Minutes before session expiry to show warning popup
SLEA_SESSION_WARNING_MINUTES=5

# Number of days OTP is considered fresh (for validation logic)
SLEA_OTP_FRESH_DAYS=30

# OTP expiration time in minutes
SLEA_OTP_LIFETIME_MINUTES=10

# ---------------------------------------
# Cache, Files, Queue
# ---------------------------------------

# Cache storage
CACHE_STORE=file

# Queue driver (sync recommended unless using workers)
QUEUE_CONNECTION=sync

# File storage disk
FILESYSTEM_DISK=local

# ---------------------------------------
# Redis (Optional)
# ---------------------------------------

# Used only if Redis is installed and enabled
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------------------------------------
# Email (SMTP) Configuration
# ---------------------------------------

# Mail driver (SMTP recommended)
MAIL_MAILER=smtp

# SMTP server
# Example:
#   smtp.gmail.com
#   smtp.office365.com
MAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
MAIL_PORT=587

# SMTP account email
# Example:
#   noreply@usep.edu.ph
MAIL_USERNAME=

# SMTP account password or app password
MAIL_PASSWORD=

# Encryption type: tls | ssl
MAIL_ENCRYPTION=tls

# Sender email address
MAIL_FROM_ADDRESS=

# Sender display name
MAIL_FROM_NAME="SLEA System"

# ---------------------------------------
# AWS (Optional – only if used)
# ---------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------
# Frontend (Vite)
# ---------------------------------------

VITE_APP_NAME="${APP_NAME}"
